# SHARED base-image unit - single source of truth for the lair-keystore systemd
# unit. Consumed verbatim by BOTH heart's cloud-init (base64-injected by
# main.go into cloudinit/cloud-config.yaml) and the local-testnet fleet image
# (COPYed by automation/emulation/heart/Dockerfile). Keep it invariant: per-target
# divergences go in a .service.d drop-in, never here (the fleet adds a
# holochain-first-boot ordering drop-in; prod needs none).
[Unit]
Description=Lair Keystore
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
Group=root
ExecStart=/bin/bash -c 'printf "%%s" "$(cat /var/lib/holochain/lair-passphrase)" | /usr/local/bin/lair-keystore --lair-root /var/lib/holochain/lair server --piped'
# Grant the lair socket to the `lair` group so co-located non-root services
# (bridge-orchestrator, pricing_oracle - already added to `lair` for the
# passphrase) can dial it. lair creates the socket root:root srwxr-xr-x, and
# group membership alone does not confer socket write, so grant it explicitly.
# The socket appears asynchronously after `server` starts, so wait for it;
# re-runs on every (re)start since Restart=always recreates it root:root. (B92)
ExecStartPost=/bin/bash -c 'for i in $(seq 1 100); do if [ -S /var/lib/holochain/lair/socket ]; then chgrp lair /var/lib/holochain/lair/socket && chmod g+w /var/lib/holochain/lair/socket && exit 0 || exit 1; fi; sleep 0.2; done; echo "lair socket not present after 20s - group grant skipped" >&2'
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
ProtectSystem=full
ReadWritePaths=/var/lib/holochain
ReadWritePaths=/tmp
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
