# SHARED base-image unit — single source of truth for the holochain conductor
# systemd unit. Consumed verbatim by BOTH heart's cloud-init (base64-injected by
# main.go into cloudinit/cloud-config.yaml) and the local-testnet fleet image
# (COPYed by automation/local/fleet/Dockerfile). Keep it invariant: per-target
# divergences go in a .service.d drop-in, never here (prod adds the InfluxDB
# metrics env via holochain.service.d/10-metrics.conf; the local fleet has no
# metrics cloud and adds nothing).
[Unit]
Description=Holochain Conductor
After=network.target lair-keystore.service
Requires=lair-keystore.service

[Service]
Type=simple
User=root
Group=root
Environment="RUST_LOG=info"
ExecStart=/bin/bash -c 'printf "%%s" "$(cat /var/lib/holochain/lair-passphrase)" | /usr/local/bin/holochain --config-path /etc/holochain/conductor-config.yaml --piped'
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
ProtectSystem=full
ReadWritePaths=/var/lib/holochain
ReadWritePaths=/tmp
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
